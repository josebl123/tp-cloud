# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# Read natively by Spring through `spring.config.import` in application.yml, which also reads
# /etc/queue/queue.env on a deployed instance. Anything set here wins over the defaults in that file,
# and anything left out falls back to them.
#
# Properties-file syntax, NOT shell syntax:
#   - no `export` prefix
#   - no quotes - they would become part of the value
#   - spaces inside a value are fine (a Gmail App Password has them)

# --- Database ---------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:55432/qdb
DB_USER=q
DB_PASSWORD=q
# Each instance also holds one connection outside this pool for LISTEN/NOTIFY, so budget
# (max ASG size x (this + 1)) under ~80% of the database's max_connections.
DB_POOL_MAX=10

# --- Security ---------------------------------------------------------------
# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=12h

# --- Where the SPA lives ----------------------------------------------------
# QR codes and ticket links are built from PUBLIC_BASE_URL, and end up printed on posters.
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Email ------------------------------------------------------------------
# Local development uses Mailpit on 1025, which needs no credentials.
# Gmail: smtp.gmail.com / 587 / auth and starttls true, and a 16-character App Password
# (myaccount.google.com -> Security -> App passwords), never the account password.
# Email is the only channel a customer can be reached on, so this is not optional in production.
NOTIFY_EMAIL_ENABLED=false
NOTIFY_EMAIL_FROM=no-reply@q.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false

# --- Server -----------------------------------------------------------------
PORT=8080
